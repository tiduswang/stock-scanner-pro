# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8888
APP_DEBUG=true

# ===== Ollama 配置（本地AI模型）=====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=300

# ===== 数据缓存配置（秒）=====
CACHE_MARKET_DATA=300
CACHE_FUNDAMENTAL=3600
CACHE_NEWS=1800
CACHE_STOCK_LIST=86400

# ===== 分析默认参数 =====
# 技术面/基本面/情绪面权重（总和=1）
WEIGHT_TECHNICAL=0.45
WEIGHT_FUNDAMENTAL=0.35
WEIGHT_SENTIMENT=0.20

# 默认评分阈值（AI选股默认筛选得分>=该值的股票）
DEFAULT_SCORE_THRESHOLD=70
